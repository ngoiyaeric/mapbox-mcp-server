{
  "name": "mapbox-mcp-server",
  "version": "1.0.0",
  "type": "module",
  "module": "./src/index.ts",
  "main": "./dist/src/index.js",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "types": "./dist/src/index.d.ts",
  "bin": {
    "mapbox": "./dist/src/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "dev": "npx @smithery/cli dev",
    "build": "npx @smithery/cli build",
    "compile": "tsc -p tsconfig.json",
    "start": "npm run compile && node dist/src/index.js"
  },
  "keywords": ["mapbox", "mcp", "server", "mapbox-mcp-server"],
  "author": "AidenYangX",
  "license": "MIT",
  "description": "Mapbox integration for MCP servers",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "@smithery/cli": "^1.2.17"
  }
}